{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supoclip.local/podcast-pipeline/v1",
  "title": "Manual podcast pipeline v1",
  "type": "object",
  "required": ["version", "source", "transcript", "outputDir", "fontPath", "clips"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "source": {"type": "object", "properties": {"path": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https?://"}}, "anyOf": [{"required": ["path"]}, {"required": ["url"]}]},
    "transcript": {"type": "object", "required": ["path", "units"], "properties": {"path": {"type": "string", "minLength": 1}, "units": {"enum": ["seconds", "milliseconds"]}}},
    "outputDir": {"type": "string", "minLength": 1},
    "fontPath": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 2, "multipleOf": 2, "default": 1080},
    "height": {"type": "integer", "minimum": 2, "multipleOf": 2, "default": 1920},
    "fps": {"type": "integer", "minimum": 1, "default": 30},
    "crf": {"enum": [18, 19], "default": 19},
    "renderOptions": {"$ref": "#/$defs/renderOptions"},
    "clips": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clip"}}
  },
  "$defs": {
    "renderOptions": {"type": "object", "description": "Merged into the Remotion job; JS owns validation of supported graphics props. Pipeline-owned paths, dimensions, fps, words, durationInFrames and frameRange cannot be overridden.", "propertyNames": {"not": {"enum": ["videoPath", "outputPath", "fontPath", "fps", "durationInFrames", "width", "height", "words", "frameRange"]}}},
    "range": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "minItems": 2, "maxItems": 2},
    "crop": {"type": "object", "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "minimum": 2}, "height": {"type": "number", "minimum": 2}}},
    "shot": {
      "type": "object", "required": ["rangeIndex", "start", "end"],
      "properties": {
        "rangeIndex": {"type": "integer", "minimum": 0},
        "start": {"type": "number", "minimum": 0, "description": "Source seconds"},
        "end": {"type": "number", "exclusiveMinimum": 0, "description": "Source seconds; audio continues through this point"},
        "videoEnd": {"type": "number", "exclusiveMinimum": 0, "description": "Optional last safe source picture boundary. Last retained frame is held through end, without cutting audio. Requires reviewed=true."},
        "reviewed": {"type": "boolean"},
        "reaction": {"type": "boolean", "description": "True requires >=3 second hold"},
        "mode": {"enum": ["auto", "contain", "crop"], "default": "auto"},
        "crop": {"$ref": "#/$defs/crop"},
        "track": {"type": "array", "items": {"type": "object", "required": ["time", "x", "y"], "properties": {"time": {"type": "number", "minimum": 0, "description": "Shot-relative seconds; strictly increasing"}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}}}}
      },
      "allOf": [{"if": {"properties": {"mode": {"const": "crop"}}, "required": ["mode"]}, "then": {"required": ["crop", "reviewed"], "properties": {"reviewed": {"const": true}}}}, {"if": {"required": ["videoEnd"]}, "then": {"required": ["reviewed"], "properties": {"reviewed": {"const": true}}}}]
    },
    "clip": {
      "type": "object", "required": ["id", "ranges", "headline", "sourceNotes", "payoff", "postCaption"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
        "ranges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/range"}, "description": "Ordered source-second keep ranges; can reorder the hook. Each duration is rounded to a frame independently."},
        "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}, "description": "If supplied, must partition every range exactly; reset at camera cuts. Empty means one auto shot per range."},
        "approval": {"type": "object", "properties": {"approved": {"type": "boolean"}, "reviewer": {"type": "string"}, "reviewedAt": {"type": "string"}}, "allOf": [{"if": {"properties": {"approved": {"const": true}}, "required": ["approved"]}, "then": {"required": ["reviewer", "reviewedAt"], "properties": {"reviewer": {"minLength": 1}, "reviewedAt": {"minLength": 1}}}}]},
        "headline": {"type": "string"}, "sourceNotes": {"type": "string"}, "payoff": {"type": "string"}, "postCaption": {"type": "string"},
        "captions": {"type": "object", "properties": {"style": {"enum": ["clean", "bold"]}, "headlineDuration": {"type": "number", "minimum": 0}, "headlineAccent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "strikeWords": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1}}}},
        "graphics": {"type": "object", "description": "Editorial intent only. Does not fabricate renderer props. Put supported JS props in renderOptions."},
        "renderOptions": {"$ref": "#/$defs/renderOptions"},
        "riser": {"type": "object", "required": ["path", "crestSeconds", "cutSeconds", "semanticNote"], "properties": {"path": {"type": "string", "minLength": 1}, "crestSeconds": {"type": "number", "exclusiveMinimum": 0}, "cutSeconds": {"type": "number", "exclusiveMinimum": 0}, "gain": {"type": "number", "minimum": 0, "default": 0.28}, "semanticNote": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
